# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/restaurant_menu_db?retryWrites=true&w=majority

# CORS Configuration (Client URL for Vercel/Local Development)
# Multiple origins can be comma-separated: http://localhost:5173,https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_should_be_long_and_complex_change_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
